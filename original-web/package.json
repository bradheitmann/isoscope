{
  "name": "isoscope-original-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "qc:layout": "bun scripts/edge-layout-qc.ts",
    "graph:codebase": "bun scripts/codebase-graph.ts",
    "regen:codebase-map": "bun scripts/codebase-graph.ts --out examples/codebase.spec.json",
    "check:chunks": "bun scripts/check-chunks.ts",
    "check:codebase-map": "bun scripts/check-codebase-map.ts",
    "qa": "bun tests/qa/run.ts",
    "qa:static": "bun tests/qa/run.ts --static"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "@types/node": "22.18.6",
    "@types/three": "0.180.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
