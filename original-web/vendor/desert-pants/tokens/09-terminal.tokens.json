{
  "$description": "Terminal UI: colour roles, text attributes, box drawing, cells and component recipes for the character grid.",
  "$extensions": {
    "com.desertpants": {
      "system": "desert-pants",
      "format": "DTCG 2025.10",
      "source": "Visual language derived from desertant.com (brand/index.css, assets/site.css, captured 2026-09-23/24). Logos, marks, product names, photography and copy are not included.",
      "modes": [
        "light",
        "dark"
      ]
    }
  },
  "tui": {
    "$description": "Terminal UI: the design system in a character grid. Colour roles per theme and mode (24-bit, with xterm-256 and ANSI-16 forms solved for contrast), text roles as SGR attributes, box drawing from the radius and border-width scales, spacing in cells and component recipes. Generated into build/tui (a dependency-free Rust module, a ratatui adapter, JSON) and build/terminal (colour schemes for terminal emulators).",
    "$extensions": {
      "com.desertpants": {
        "origin": "addition",
        "platforms": [
          "terminal"
        ]
      }
    },
    "cell": {
      "width": {
        "$type": "number",
        "$value": 8,
        "$description": "Pixels per terminal column: widths on the pixel scales (breakpoints, containers) divide by it.",
        "$extensions": {
          "com.desertpants": {
            "origin": "addition"
          }
        }
      },
      "height": {
        "$type": "number",
        "$value": 16,
        "$description": "Pixels per terminal row.",
        "$extensions": {
          "com.desertpants": {
            "origin": "addition"
          }
        }
      }
    },
    "size": {
      "min-columns": {
        "$type": "number",
        "$value": 80,
        "$description": "Narrowest terminal every layout is designed for (columns).",
        "$extensions": {
          "com.desertpants": {
            "origin": "addition"
          }
        }
      },
      "min-rows": {
        "$type": "number",
        "$value": 24,
        "$description": "Shortest terminal every layout is designed for (rows).",
        "$extensions": {
          "com.desertpants": {
            "origin": "addition"
          }
        }
      },
      "measure": {
        "$type": "number",
        "$value": 72,
        "$description": "Longest line of running text (columns), like the prose container on screen.",
        "$extensions": {
          "com.desertpants": {
            "origin": "addition"
          }
        }
      }
    },
    "color": {
      "bg": {
