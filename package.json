{
  "name": "isoscope",
  "version": "0.2.0",
  "description": "Schematic observability: your system as an inspectable isometric city, driven by one JSON spec or a SQLite graph store.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.1.0"
  },
  "bin": {
    "isoscope": "./cli.ts",
    "isoscope-mcp": "./mcp.ts"
  },
  "scripts": {
    "build:self": "bun cli.ts render examples/isoscope.spec.json out/isoscope.html",
    "build:odin": "bun build.ts examples/odin.spec.json out/odin.html",
    "mcp": "bun mcp.ts",
    "drc": "bun drc.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./tests/",
    "proof:contrast": "bun cli.ts render examples/isoscope.spec.json out/isoscope-contrast.html && bun scripts/contrast-proof.ts out/isoscope-contrast.html tokyo-night out/isoscope-contrast.png",
    "build:lumbr": "bun cli.ts render examples/lumbr.spec.json out/lumbr.html"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "happy-dom": "^21.0.3",
    "typescript": "5.9.2"
  },
  "exports": {
    ".": "./index.ts",
    "./graph": "./lib.ts",
    "./render": "./build.ts",
    "./live": "./live.ts",
    "./safe-html": "./safe-html.ts",
    "./*": "./*"
  }
}
